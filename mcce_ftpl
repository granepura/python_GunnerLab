#!/usr/bin/env python3
"""
mcce_ftpl — MCCE4 Topology File AI Agent
====================================================

Launcher script. Place this in MCCE4-Alpha/bin/ alongside the
mcce_ftpl_agent/ package directory.

Input (use exactly one):
  mcce_ftpl EMH.pdb                                      # PDB file
  mcce_ftpl EMH.cif                                      # CIF file (auto-converts)
  mcce_ftpl -lig_code EMH                                # 3-letter RCSB ligand code
  mcce_ftpl -smiles "c1ccccc1" -lig_id BEN               # SMILES string + 3-letter code
  mcce_ftpl -smiles EMH.smi                              # SMILES from .smi file (code from filename)

Options:
  mcce_ftpl EMH.pdb --dry-run --no-llm                   # Quick test
  mcce_ftpl EMH.pdb --gui                                # Web GUI
  mcce_ftpl EMH.pdb -state_pdbs EMH_01.pdb EMH_+1.pdb    # User states
  mcce_ftpl EMH.pdb -charge_method am1bcc                # Override charges
  mcce_ftpl -lig_code EMH -llm_provider claude           # Use Claude LLM
  mcce_ftpl -smiles "CCO" -lig_id ETH -ph_min 5.0        # Custom pH range

Install dependencies:
  conda install -c conda-forge google-genai langgraph dimorphite_dl rdkit streamlit
  conda install -c conda-forge anthropic openai  # optional, for Claude/ChatGPT providers
  export GEMINI_API_KEY="your_free_key"   # from https://ai.google.dev
  export ANTHROPIC_API_KEY="your_key"     # for Claude provider
  export OPENAI_API_KEY="your_key"        # for ChatGPT provider
"""

import sys
import os

# Ensure the package is findable from bin/
SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
if SCRIPT_DIR not in sys.path:
    sys.path.insert(0, SCRIPT_DIR)

from mcce_ftpl_agent.cli import main

if __name__ == "__main__":
    main()
