#!/usr/bin/env python3
"""
mcce_ftpl — MCCE4 Topology File AI Agent
====================================================

Launcher script. Place this in MCCE4-Alpha/bin/ alongside the
mcce_ftpl_agent/ package directory.

Usage:
  mcce_ftpl EMH.pdb                                     # Full auto (PDB input)
  mcce_ftpl EMH.cif                                     # CIF input (auto-converts)
  mcce_ftpl -lig_code EMH                               # Ligand code only (fetches from RCSB)
  mcce_ftpl EMH.pdb -lig_code EMH                       # PDB + ligand code
  mcce_ftpl -lig_code EMH --dry-run --no-llm            # Quick test from RCSB
  mcce_ftpl EMH.pdb --gui                               # Web GUI
  mcce_ftpl EMH.pdb --state-pdbs EMH_01.pdb EMH_+1.pdb  # User states
  mcce_ftpl EMH.pdb --no-llm --dry-run                  # Minimal run
  mcce_ftpl EMH.pdb --llm-provider claude               # Use Claude LLM
  mcce_ftpl EMH.pdb --llm-provider chatgpt              # Use ChatGPT LLM
  mcce_ftpl EMH.pdb --llm-provider claude --api-key KEY  # Custom API key

Install dependencies:
  conda install -c conda-forge google-genai langgraph dimorphite_dl rdkit streamlit
  conda install -c conda-forge anthropic openai  # optional, for Claude/ChatGPT providers
  export GEMINI_API_KEY="your_free_key"   # from https://ai.google.dev
  export ANTHROPIC_API_KEY="your_key"     # for Claude provider
  export OPENAI_API_KEY="your_key"        # for ChatGPT provider
"""

import sys
import os

# Ensure the package is findable from bin/
SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
if SCRIPT_DIR not in sys.path:
    sys.path.insert(0, SCRIPT_DIR)

from mcce_ftpl_agent.cli import main

if __name__ == "__main__":
    main()
